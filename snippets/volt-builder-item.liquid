{%- comment -%}
  One selectable product card for the Build Your Setup section.

  Accepts:
  - product {Product} the product to show
  - group_id {String} id of the step (block) it belongs to
  - pick_one {Boolean} radio (pick one per step) instead of checkbox
  - section_id {String}
  - preselect {Boolean} selected when the page loads
  - low_stock {Number} show the low-stock note at or below this count; 0 turns it off
  - low_stock_text {String} low-stock note, [count] is replaced with the number left

  Fitment comes from product tags (edit them in Shopify admin > Products):
  - fits:<bike key>          e.g. fits:super73, or fits:all for every bike
  - pick:<bike key>:<text>   only offer options whose name contains <text> for that bike,
                             e.g. pick:super73:3 Pin Female For Super73
  Prices, images and stock come from the live product.
{%- endcomment -%}
{%- liquid
  assign input_id = 'vb-' | append: section_id | append: '-' | append: group_id | append: '-' | append: product.id
  assign current = product.selected_or_first_available_variant
  assign has_choice = true
  if product.has_only_default_variant
    assign has_choice = false
  endif

  assign fits = ''
  assign picks = ''
  for tag in product.tags
    assign tag_start = tag | slice: 0, 5
    if tag_start == 'fits:'
      assign key = tag | remove_first: 'fits:' | downcase | strip
      assign fits = fits | append: key | append: ','
    elsif tag_start == 'pick:'
      assign rest = tag | remove_first: 'pick:'
      assign pick_bike = rest | split: ':' | first | downcase | strip
      assign pick_prefix = rest | split: ':' | first | append: ':'
      assign pick_text = rest | remove_first: pick_prefix | strip
      assign picks = picks | append: pick_bike | append: '|' | append: pick_text | append: '||'
    endif
  endfor
-%}
<div
  class="vb-item vb-item--{% if pick_one %}one{% else %}any{% endif %}{% if preselect %} is-selected{% endif %}"
  data-vb-item
  data-fits="{{ fits }}"
  data-picks="{{ picks | escape }}"
  data-title="{{ product.title | escape }}"
  hidden
>
  <label class="vb-item__pick" for="{{ input_id }}">
    <input
      type="{% if pick_one %}radio{% else %}checkbox{% endif %}"
      id="{{ input_id }}"
      name="{% if pick_one %}vb-{{ section_id }}-{{ group_id }}{% else %}{{ input_id }}{% endif %}"
      value="{{ current.id }}"
      data-vb-input
      {% if preselect %}checked data-vb-preselect{% endif %}
    >
    <span class="vb-item__media">
      {%- if product.featured_image -%}
        {{
          product.featured_image
          | image_url: width: 400
          | image_tag:
            loading: 'lazy',
            widths: '200, 400',
            sizes: '96px',
            alt: product.title,
            class: 'vb-item__img'
        }}
      {%- endif -%}
    </span>
    <span class="vb-item__info">
      <span class="vb-item__title">{{ product.title | escape }}</span>
      <span class="vb-item__price" data-vb-price>
        <span>{{ current.price | money }}</span>
        {%- if current.compare_at_price > current.price -%}
          <s class="vb-item__was">{{ current.compare_at_price | money }}</s>
        {%- endif -%}
      </span>
      <span class="vb-item__stock" data-vb-stock>
        {%- if low_stock > 0 and current.inventory_management == 'shopify' and current.inventory_policy == 'deny' and current.inventory_quantity > 0 and current.inventory_quantity <= low_stock -%}
          {{ low_stock_text | replace: '[count]', current.inventory_quantity | escape }}
        {%- endif -%}
      </span>
    </span>
    <span class="vb-item__check" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>
    </span>
  </label>

  {%- if has_choice -%}
    <div class="vb-item__variant">
      <label for="{{ input_id }}-variant">{{ product.options | join: ' / ' | escape }}</label>
      <select id="{{ input_id }}-variant" data-vb-variant>
        {%- for variant in product.variants -%}
          {%- if variant.available -%}
            <option value="{{ variant.id }}" {% if variant.id == current.id %}selected{% endif %}>{{ variant.title | escape }}</option>
          {%- endif -%}
        {%- endfor -%}
      </select>
    </div>
  {%- endif -%}

  <script type="application/json" data-vb-variants>
    [
      {%- for variant in product.variants -%}
        {%- liquid
          assign v_low = nil
          if low_stock > 0 and variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' and variant.inventory_quantity > 0 and variant.inventory_quantity <= low_stock
            assign v_low = variant.inventory_quantity
          endif
        -%}
        {"id":{{ variant.id | json }},"title":{{ variant.title | json }},"price":{{ variant.price | json }},"compare":{{ variant.compare_at_price | default: 0 | json }},"available":{{ variant.available | json }},"low":{{ v_low | json }}{% if variant.featured_image %},"img":{{ variant.featured_image | image_url: width: 200 | json }},"img2x":{{ variant.featured_image | image_url: width: 400 | json }}{% endif %}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</div>
