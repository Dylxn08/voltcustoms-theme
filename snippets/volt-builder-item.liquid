{%- comment -%}
  One selectable product card for the Build Your Setup section.

  Accepts:
  - product {Product} the product to show
  - block {Block} the light/add-on block that picked it
  - kind {String} 'light' (radio, pick one) or 'addon' (checkbox, pick any)
  - section_id {String}
  - low_stock {Number} show the low-stock note at or below this count; 0 turns it off
  - low_stock_text {String} low-stock note, [count] is replaced with the number left
  - fits_prefix {String} word shown before the bike list, e.g. "Fits"

  Prices, images and stock all come from the live product. Sold-out variants are
  rendered as disabled options; a product with nothing in stock can't be selected.
{%- endcomment -%}
{%- liquid
  assign input_type = 'radio'
  if kind == 'addon'
    assign input_type = 'checkbox'
  endif
  assign input_id = 'vb-' | append: section_id | append: '-' | append: block.id
  assign current = product.selected_or_first_available_variant
  assign has_choice = true
  if product.has_only_default_variant
    assign has_choice = false
  endif

  assign fits_keys = ''
  assign fits_label = block.settings.fits | strip
  if fits_label != blank
    assign fits_parts = fits_label | split: ','
    for part in fits_parts
      assign key = part | strip | handleize | remove: '-'
      if key != blank
        assign fits_keys = fits_keys | append: key | append: ','
      endif
    endfor
  endif

  assign preselect = false
  if block.settings.preselect and product.available
    assign preselect = true
  endif
-%}
<div
  class="vb-item vb-item--{{ kind }}{% unless product.available %} is-unavailable{% endunless %}{% if preselect %} is-selected{% endif %}"
  data-vb-item
  data-kind="{{ kind }}"
  data-fits="{{ fits_keys }}"
  data-title="{{ product.title | escape }}"
  {{ block.shopify_attributes }}
>
  <label class="vb-item__pick" for="{{ input_id }}">
    <input
      type="{{ input_type }}"
      id="{{ input_id }}"
      name="{% if kind == 'light' %}vb-light-{{ section_id }}{% else %}vb-addon-{{ block.id }}{% endif %}"
      value="{{ current.id }}"
      data-vb-input
      {% if preselect %}checked{% endif %}
      {% unless product.available %}disabled aria-describedby="{{ input_id }}-stock"{% endunless %}
    >
    <span class="vb-item__media">
      {%- assign image = current.featured_image | default: product.featured_image -%}
      {%- if image -%}
        {{
          image
          | image_url: width: 400
          | image_tag:
            loading: 'lazy',
            widths: '200, 400',
            sizes: '96px',
            alt: product.title,
            class: 'vb-item__img'
        }}
      {%- endif -%}
    </span>
    <span class="vb-item__info">
      {%- if block.settings.badge != blank -%}
        <span class="vb-item__badge">{{ block.settings.badge | escape }}</span>
      {%- endif -%}
      <span class="vb-item__title">{{ product.title | escape }}</span>
      <span class="vb-item__price" data-vb-price>
        <span>{{ current.price | money }}</span>
        {%- if current.compare_at_price > current.price -%}
          <s class="vb-item__was">{{ current.compare_at_price | money }}</s>
        {%- endif -%}
      </span>
      {%- if fits_label != blank -%}
        <span class="vb-item__meta">{{ fits_prefix | escape }} {{ fits_label | escape }}</span>
      {%- endif -%}
      <span class="vb-item__stock" id="{{ input_id }}-stock" data-vb-stock>
        {%- if product.available == false -%}
          {{ 'products.product.sold_out' | t }}
        {%- elsif low_stock > 0 and current.inventory_management == 'shopify' and current.inventory_policy == 'deny' and current.inventory_quantity > 0 and current.inventory_quantity <= low_stock -%}
          {{ low_stock_text | replace: '[count]', current.inventory_quantity | escape }}
        {%- endif -%}
      </span>
    </span>
    <span class="vb-item__check" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>
    </span>
  </label>

  {%- if has_choice and product.available -%}
    <div class="vb-item__variant">
      <label for="{{ input_id }}-variant">{{ product.options | join: ' / ' | escape }}</label>
      <select id="{{ input_id }}-variant" data-vb-variant>
        {%- for variant in product.variants -%}
          <option
            value="{{ variant.id }}"
            {% if variant.id == current.id %}selected{% endif %}
            {% unless variant.available %}disabled{% endunless %}
          >
            {{ variant.title | escape }}
            {%- unless variant.available %} - {{ 'products.product.sold_out' | t }}{% endunless -%}
          </option>
        {%- endfor -%}
      </select>
    </div>
  {%- endif -%}

  <script type="application/json" data-vb-variants>
    [
      {%- for variant in product.variants -%}
        {%- liquid
          assign v_low = nil
          if low_stock > 0 and variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' and variant.inventory_quantity > 0 and variant.inventory_quantity <= low_stock
            assign v_low = variant.inventory_quantity
          endif
          assign v_image = variant.featured_image | default: product.featured_image
        -%}
        {
          "id": {{ variant.id | json }},
          "title": {{ variant.title | json }},
          "price": {{ variant.price | json }},
          "compare": {{ variant.compare_at_price | default: 0 | json }},
          "available": {{ variant.available | json }},
          "low": {{ v_low | json }},
          "img": {% if v_image %}{{ v_image | image_url: width: 200 | json }}{% else %}null{% endif %},
          "img2x": {% if v_image %}{{ v_image | image_url: width: 400 | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</div>
