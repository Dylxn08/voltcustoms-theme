<section class='vs-why' id='vs-why-{{ section.id }}'>
  <h2 class='vs-why__title'>{{ section.settings.title_main | escape }}{% if section.settings.title_dim != blank %} <span class='vs-dim'>{{ section.settings.title_dim | escape }}</span>{% endif %}</h2>
  <div class='vs-why__grid'>
    {%- for block in section.blocks -%}
      {%- capture num -%}{%- if forloop.index < 10 -%}0{%- endif -%}{{ forloop.index }}{%- endcapture -%}
      {%- capture total -%}{%- if forloop.length < 10 -%}0{%- endif -%}{{ forloop.length }}{%- endcapture -%}
      {%- assign vw_text = block.settings.text | escape -%}
      {%- if vw_text contains '[rating]' or vw_text contains '[count]' -%}
        {%- unless vw_totals_done -%}{%- capture vw_t -%}{%- render 'volt-store-totals' -%}{%- endcapture -%}{%- assign vw_parts = vw_t | strip | split: '|' -%}{%- assign vw_totals_done = true -%}{%- endunless -%}
        {%- if vw_parts[1] == '0' -%}{%- continue -%}{%- endif -%}
        {%- assign vw_text = vw_text | replace: '[rating]', vw_parts[0] | replace: '[count]', vw_parts[1] -%}
      {%- endif -%}
      <div class='vs-why__card' {{ block.shopify_attributes }}>
        <span class='vs-why__num'>{{ num }} / {{ total }}</span>
        <span class='vs-why__icon'><svg viewBox='0 0 24 24' fill='none' stroke='#fff' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
          {%- case block.settings.icon -%}
            {%- when 'plug' -%}<path d='M9 2v6M15 2v6M7 8h10v4a5 5 0 0 1-10 0V8zM12 17v5'/>
            {%- when 'battery' -%}<rect x='2' y='7' width='18' height='10' rx='2'/><path d='M22 11v2M11 9l-2 3h4l-2 3'/>
            {%- when 'truck' -%}<path d='M1 6h13v10H1zM14 10h4l3 3v3h-7z'/><circle cx='5' cy='18' r='2'/><circle cx='17' cy='18' r='2'/>
            {%- when 'star' -%}<polygon points='12 2 15 9 22 9.5 17 14.5 18.5 22 12 18 5.5 22 7 14.5 2 9.5 9 9'/>
            {%- when 'users' -%}<circle cx='9' cy='7' r='3'/><path d='M3 20v-1a5 5 0 0 1 10 0v1'/><circle cx='17' cy='8' r='2.5'/><path d='M15 14a4 4 0 0 1 6 4v2'/>
            {%- when 'shield' -%}<path d='M12 2l8 3v6c0 5-3.5 9-8 11-4.5-2-8-6-8-11V5z'/><path d='M9 12l2 2 4-4'/>
            {%- when 'tag' -%}<path d='M20 12l-8 8-9-9V3h8z'/><circle cx='7.5' cy='7.5' r='1.5'/>
            {%- else -%}<polygon points='13 2 4 14 11 14 10 22 20 9 13 9'/>
          {%- endcase -%}
        </svg></span>
        <h3 class='vs-why__ctitle'>{{ block.settings.title | escape }}</h3>
        <p class='vs-why__text'>{{ vw_text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}{"name":"Volt why riders choose us","settings":[{"type":"text","id":"title_main","label":"Title","default":"Why riders choose"},{"type":"text","id":"title_dim","label":"Title (grey part)","default":"us"}],"blocks":[{"type":"card","name":"Card","settings":[{"type":"select","id":"icon","label":"Icon","default":"bolt","options":[{"value":"bolt","label":"Bolt"},{"value":"plug","label":"Plug"},{"value":"battery","label":"Battery"},{"value":"truck","label":"Truck"},{"value":"star","label":"Star"},{"value":"users","label":"People"},{"value":"shield","label":"Shield"},{"value":"tag","label":"Tag"}]},{"type":"text","id":"title","label":"Title","default":"Reason"},{"type":"textarea","id":"text","label":"Text","info":"Use [rating] and [count] to show your live Shop review numbers."}]}],"max_blocks":9,"presets":[{"name":"Volt why riders choose us"}]}{% endschema %}
