{%- assign hero_alt = section.settings.heading | strip_newlines | escape -%}
<section id='vs-hero-{{ section.id }}' class='vs-hero' style='--vs-h:{{ section.settings.height }}vh;--vs-focal:{{ section.settings.focal }}'>
  <picture>
    {%- if section.settings.image_mobile != blank -%}
      <source media='(max-width: 749px)' srcset='{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w, {{ section.settings.image_mobile | image_url: width: 1500 }} 1500w' sizes='100vw'>
    {%- endif -%}
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'vs-hero__img', widths: '900, 1400, 1900, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: hero_alt }}
    {%- endif -%}
  </picture>
  <div class='vs-hero__shade' style='opacity:{{ section.settings.overlay | divided_by: 100.0 }}'></div>
  <div class='vs-hero__inner'>
    <h2 class='vs-hero__title'>{{ section.settings.heading | escape | newline_to_br }}</h2>
    {%- if section.settings.subline != blank -%}<p class='vs-hero__sub'>{{ section.settings.subline | escape }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class='vs-btn vs-btn--dark' href='{{ section.settings.button_link | default: routes.all_products_collection_url }}'>{{ section.settings.button_label | escape }}<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12h14M13 6l6 6-6 6'/></svg></a>
    {%- endif -%}
  </div>
</section>
{% schema %}{"name":"Volt hero","settings":[{"type":"image_picker","id":"image","label":"Image","info":"Landscape, at least 2400px wide. Keep the middle darker so the white text reads."},{"type":"image_picker","id":"image_mobile","label":"Phone image (optional)","info":"Portrait 4:5 or 9:16. Used on phones instead of the main image."},{"type":"select","id":"focal","label":"Image focus","default":"center","options":[{"value":"center","label":"Center"},{"value":"center top","label":"Top"},{"value":"center bottom","label":"Bottom"},{"value":"left center","label":"Left"},{"value":"right center","label":"Right"}]},{"type":"range","id":"overlay","label":"Dark overlay","min":0,"max":80,"step":5,"unit":"%","default":45},{"type":"range","id":"height","label":"Height","min":50,"max":100,"step":5,"unit":"vh","default":85},{"type":"textarea","id":"heading","label":"Heading (new line = line break)","default":"Light up your\nride today."},{"type":"text","id":"subline","label":"Subline","default":"Battery powered • Plug and play • Factory grade"},{"type":"text","id":"button_label","label":"Button label","default":"Shop best sellers"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Volt hero"}]}{% endschema %}
