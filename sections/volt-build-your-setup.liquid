{%- comment -%}
  Build Your Setup: pick your bike, then see only the products that fit it, and add everything
  to the cart in one request.

  How products get here (no code needed):
  - Each "Step" block shows products tagged with its group tag, e.g. builder:lights.
  - Each product also needs fitment tags: fits:super73, fits:surron ... or fits:all.
  - Optional pick:<bike>:<option text> tags limit a product's options for one bike,
    e.g. pick:super73:3 Pin Female For Super73.
  - Each "Bike" block has a tag key (super73, surron ...) that must match those tags.
    A bike with the key "other" only sees products tagged fits:all.
  - Sold-out products are hidden. The Black Friday banner is in Theme settings.

  Prices, images and stock are read from the live products. This section never changes prices:
  discounts are applied by Shopify in the cart and at checkout.
{%- endcomment -%}
{{ 'volt-builder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'volt-builder.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign bikes = section.blocks | where: 'type', 'bike'
  assign groups = section.blocks | where: 'type', 'group'
  assign bike_input_name = 'vb-bike-' | append: section.id
  assign source = section.settings.collection | default: collections.all
  assign heading_tag = 'h2'
  if section.settings.heading_is_h1
    assign heading_tag = 'h1'
  endif
-%}

<section
  class="vb"
  id="vb-{{ section.id }}"
  data-volt-builder
  data-currency="{{ cart.currency.iso_code }}"
  data-locale="{{ request.locale.iso_code }}"
  data-cart-url="{{ routes.cart_url }}"
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-msg-need-bike="{{ section.settings.msg_need_bike | escape }}"
  data-msg-need-item="{{ section.settings.msg_need_item | escape }}"
  data-msg-adding="{{ section.settings.msg_adding | escape }}"
  data-msg-added="{{ section.settings.msg_added | escape }}"
  data-msg-error="{{ section.settings.msg_error | escape }}"
  data-msg-items="{{ section.settings.summary_toggle | escape }}"
  data-msg-low="{{ section.settings.low_stock_text | escape }}"
  data-msg-bike-meta="{{ section.settings.bike_meta | escape }}"
>
  {%- if settings.bf_banner_enabled and settings.bf_banner_text != blank -%}
    <div class="vb-bf">
      <p>{{ settings.bf_banner_text | escape }}</p>
    </div>
  {%- endif -%}

  <div class="vb__head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="vs-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <{{ heading_tag }} class="vs-h2 vb__title">{{ section.settings.heading | escape }}</{{ heading_tag }}>
    {%- if section.settings.subheading != blank -%}
      <p class="vb__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
  </div>

  <div class="vb__layout">
    <form class="vb__steps" action="{{ routes.cart_add_url }}" method="post" novalidate data-vb-form>
      <fieldset class="vb-step" id="vb-{{ section.id }}-step-bike" tabindex="-1">
        <legend class="vb-step__legend">
          <span class="vb-step__num">{{ section.settings.step1_eyebrow | escape }}</span>
          <span class="vb-step__title">{{ section.settings.step1_title | escape }}</span>
        </legend>
        <div class="vb-bikes" data-vb-bikes>
          {%- for block in bikes -%}
            {%- render 'volt-bike-card', block: block, index: forloop.index, input_name: bike_input_name -%}
          {%- endfor -%}
        </div>
        <div class="vb-bikes__nav">
          <button type="button" class="vb-bikes__arrow" data-vb-bikes-prev aria-label="{{ section.settings.prev_label | escape }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
          </button>
          <span class="vb-bikes__count" data-vb-bikes-count aria-hidden="true">01 / {% if bikes.size < 10 %}0{% endif %}{{ bikes.size }}</span>
          <button type="button" class="vb-bikes__arrow" data-vb-bikes-next aria-label="{{ section.settings.next_label | escape }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
        </div>
        <p class="vb-prompt" data-vb-prompt>{{ section.settings.prompt_text | escape }}</p>
      </fieldset>

      {%- paginate source.products by 250 -%}
        {%- for block in groups -%}
          {%- assign group_tag = block.settings.tag | strip -%}
          <fieldset class="vb-step" data-vb-step hidden {{ block.shopify_attributes }}>
            <legend class="vb-step__legend">
              <span class="vb-step__num" data-vb-step-num data-template="{{ block.settings.eyebrow | escape }}">{{ block.settings.eyebrow | replace: '[n]', '' | escape }}</span>
              <span class="vb-step__title" data-vb-step-title data-template="{{ block.settings.title | escape }}">{{ block.settings.title | replace: '[bike]', '' | escape }}</span>
            </legend>
            <div class="vb-items">
              {%- for product in source.products -%}
                {%- if product.available and group_tag != blank and product.tags contains group_tag -%}
                  {%- liquid
                    assign preselect = false
                    if section.settings.preselect_product != blank and section.settings.preselect_product.id == product.id
                      assign preselect = true
                    endif
                  -%}
                  {%- render 'volt-builder-item',
                    product: product,
                    group_id: block.id,
                    pick_one: block.settings.pick_one,
                    section_id: section.id,
                    preselect: preselect,
                    low_stock: section.settings.low_stock_threshold,
                    low_stock_text: section.settings.low_stock_text
                  -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endpaginate -%}
    </form>

    <aside class="vb-sum" aria-labelledby="vb-{{ section.id }}-sum-title">
      <h2 class="vb-sum__title" id="vb-{{ section.id }}-sum-title">{{ section.settings.summary_title | escape }}</h2>
      <details class="vb-sum__details" open data-vb-details>
        <summary data-vb-toggle>{{ section.settings.summary_toggle | replace: '[count]', '0' | escape }}</summary>
        <ul class="vb-sum__list" data-vb-list></ul>
        <p class="vb-sum__empty" data-vb-list-empty>{{ section.settings.summary_empty | escape }}</p>
      </details>
      <div class="vb-sum__total">
        <span class="vb-sum__total-label">{{ section.settings.total_label | escape }}</span>
        <span class="vb-sum__total-value" data-vb-total aria-live="polite" aria-atomic="true">{{ 0 | money }}</span>
      </div>
      {%- if section.settings.total_note != blank -%}
        <p class="vb-sum__note">{{ section.settings.total_note | escape }}</p>
      {%- endif -%}
      <button type="button" class="vs-btn vs-btn--dark vb-sum__btn" data-vb-submit aria-disabled="true">
        {{ section.settings.button_label | escape }}
      </button>
      <p class="vb-sum__status" role="status" data-vb-status></p>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Volt build your setup",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Small text above", "default": "Black Friday builder" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your setup" },
    { "type": "checkbox", "id": "heading_is_h1", "label": "Use as the page's main heading (H1)", "default": true },
    { "type": "text", "id": "subheading", "label": "Text below heading", "default": "Pick your bike and we'll show everything that fits it." },
    { "type": "header", "content": "Products" },
    { "type": "collection", "id": "collection", "label": "Products come from", "info": "Leave empty to use all products. Only products with a step's tag and a fits: tag are shown." },
    { "type": "product", "id": "preselect_product", "label": "Selected when the page loads", "info": "E.g. the free Ignition Spinner." },
    { "type": "range", "id": "low_stock_threshold", "label": "Show low-stock note at or below", "min": 0, "max": 20, "step": 1, "default": 5, "info": "Set to 0 to hide it." },
    { "type": "text", "id": "low_stock_text", "label": "Low-stock note", "default": "Only [count] left", "info": "[count] is replaced with the number in stock." },
    { "type": "header", "content": "Step 1" },
    { "type": "text", "id": "step1_eyebrow", "label": "Small text", "default": "Step 1" },
    { "type": "text", "id": "step1_title", "label": "Title", "default": "Pick your bike" },
    { "type": "text", "id": "prompt_text", "label": "Before a bike is picked", "default": "Pick your bike to see everything that fits it." },
    { "type": "text", "id": "bike_meta", "label": "Line under each bike name", "default": "[count] parts fit", "info": "[count] is the number of products that fit; you can also use [price] for the lowest price. Leave empty to hide." },
    { "type": "text", "id": "prev_label", "label": "Previous button (screen readers)", "default": "Previous bikes" },
    { "type": "text", "id": "next_label", "label": "Next button (screen readers)", "default": "Next bikes" },
    { "type": "header", "content": "Summary" },
    { "type": "text", "id": "summary_title", "label": "Title", "default": "Your setup" },
    { "type": "text", "id": "summary_toggle", "label": "Item count on phones", "default": "Your setup ([count] items)", "info": "[count] is replaced with the number of items." },
    { "type": "text", "id": "summary_empty", "label": "When nothing is picked", "default": "Nothing picked yet." },
    { "type": "text", "id": "total_label", "label": "Total label", "default": "Total" },
    { "type": "text", "id": "total_note", "label": "Note under total", "default": "Black Friday discounts apply automatically in your cart." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add all to cart" },
    { "type": "header", "content": "Messages" },
    { "type": "text", "id": "msg_need_bike", "label": "No bike picked", "default": "Pick your bike first." },
    { "type": "text", "id": "msg_need_item", "label": "No products picked", "default": "Pick at least one product." },
    { "type": "text", "id": "msg_adding", "label": "While adding", "default": "Adding to cart..." },
    { "type": "text", "id": "msg_added", "label": "After adding", "default": "Added to cart." },
    { "type": "text", "id": "msg_error", "label": "If adding fails", "default": "Couldn't add to cart. Please try again." }
  ],
  "blocks": [
    {
      "type": "bike",
      "name": "Bike",
      "settings": [
        { "type": "text", "id": "title", "label": "Bike name", "default": "Bike" },
        { "type": "text", "id": "models", "label": "Models (small text above the name)", "info": "E.g. Light Bee · Ultra Bee" },
        { "type": "text", "id": "key", "label": "Tag key", "info": "Matches product tags fits:<key> and pick:<key>:... e.g. super73. Use 'other' for a catch-all that only shows fits:all products." },
        { "type": "image_picker", "id": "image", "label": "Photo (optional override)", "info": "Usually leave empty and set the photo once in Theme settings > Bike photos. Use this only for a bike that has no slot there." },
        { "type": "select", "id": "outline", "label": "Drawing shown when there's no photo", "default": "emoto", "options": [{ "value": "emoto", "label": "E-moto (Surron style)" }, { "value": "moped", "label": "Moped (Super73 style)" }] },
        { "type": "text", "id": "badge", "label": "Badge", "info": "Optional, e.g. Most popular" }
      ]
    },
    {
      "type": "group",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Small text", "default": "Step [n]", "info": "[n] becomes the step number. Steps with nothing for the chosen bike are skipped." },
        { "type": "text", "id": "title", "label": "Title", "default": "Upgrades for your [bike]", "info": "[bike] becomes the chosen bike's name." },
        { "type": "text", "id": "tag", "label": "Product tag", "default": "builder:upgrades", "info": "Products with this tag appear in this step." },
        { "type": "checkbox", "id": "pick_one", "label": "Shopper picks only one", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Volt build your setup",
      "blocks": [
        { "type": "bike", "settings": { "title": "Super73", "key": "super73" } },
        { "type": "bike", "settings": { "title": "Other", "key": "other" } },
        { "type": "group", "settings": { "title": "Lights for your [bike]", "tag": "builder:lights", "pick_one": true } },
        { "type": "group", "settings": { "title": "Upgrades for your [bike]", "tag": "builder:upgrades" } }
      ]
    }
  ]
}
{% endschema %}
