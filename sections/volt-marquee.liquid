{%- assign mq = section.settings.text | escape -%}
<div class='vs-marq' id='vs-marq-{{ section.id }}'>
  <div class='vs-marq__track' style='animation-duration:{{ section.settings.speed }}s'>
    {%- for i in (1..8) -%}<span>{{ mq }}</span>{%- endfor -%}
  </div>
</div>
{% schema %}{"name":"Volt scrolling text","settings":[{"type":"text","id":"text","label":"Text","default":"Built for the dark"},{"type":"range","id":"speed","label":"Seconds per loop (higher = slower)","min":10,"max":120,"step":5,"default":40}],"presets":[{"name":"Volt scrolling text"}]}{% endschema %}
