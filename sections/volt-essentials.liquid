<style>
.vs-ess__card>a.vs-ess__hit.vs-ess__hit{position:absolute;inset:0;z-index:1}
.vs-ess__card>a.vs-btn.vs-btn{z-index:2}
@media (hover:hover) and (pointer:fine){
  .vs-ess__card>a.vs-btn.vs-btn{opacity:0;transform:translateY(12px);transition:opacity .3s ease,transform .3s ease}
  .vs-ess__card:hover>a.vs-btn.vs-btn,.vs-ess__card:focus-within>a.vs-btn.vs-btn{opacity:1;transform:none}
  .vs-ess__img{transition:transform .6s ease}
  .vs-ess__card:hover .vs-ess__img{transform:scale(1.04)}
}
</style>
<section id='vs-ess-{{ section.id }}' class='vs-ess'>
  <div class='vs-head'>
    {%- if section.settings.eyebrow != blank -%}<p class='vs-eyebrow'>{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2 class='vs-h2'>{{ section.settings.title | escape }}</h2>
  </div>
  <div class='vs-ess__wrap'>
    <button type='button' class='vs-ess__arrow vs-ess__arrow--prev' aria-label='Previous'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M19 12H5M11 6l-6 6 6 6'/></svg></button>
    <div class='vs-ess__track'>
      {%- for block in section.blocks -%}
        <div class='vs-ess__card' {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {%- assign card_alt = block.settings.title | escape -%}
            {{ block.settings.image | image_url: width: 1000 | image_tag: class: 'vs-ess__img', widths: '500, 800, 1000', sizes: '(min-width: 750px) 420px, 80vw', loading: 'lazy', alt: card_alt }}
          {%- endif -%}
          <div class='vs-ess__shade'></div>
          <a class='vs-ess__hit' href='{{ block.settings.link | default: routes.all_products_collection_url }}' tabindex='-1' aria-hidden='true'></a>
          {%- if block.settings.label != blank -%}<div class='vs-ess__count'>{{ block.settings.label | escape }}</div>{%- endif -%}
          <h3 class='vs-ess__title'>{{ block.settings.title | escape }}</h3>
          <a class='vs-btn vs-btn--light vs-btn--sm' href='{{ block.settings.link | default: routes.all_products_collection_url }}'>{{ block.settings.button_label | default: 'Shop now' | escape }}<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12h14M13 6l6 6-6 6'/></svg></a>
        </div>
      {%- endfor -%}
    </div>
    <button type='button' class='vs-ess__arrow vs-ess__arrow--next' aria-label='Next'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M5 12h14M13 6l6 6-6 6'/></svg></button>
  </div>
</section>
<script>
(function(){var s=document.getElementById('vs-ess-{{ section.id }}');if(!s)return;var t=s.querySelector('.vs-ess__track');function go(d){var c=t.querySelector('.vs-ess__card');var w=c?c.getBoundingClientRect().width+14:400;t.scrollBy({left:d*w,behavior:'smooth'});}s.querySelector('.vs-ess__arrow--prev').addEventListener('click',function(){go(-1)});s.querySelector('.vs-ess__arrow--next').addEventListener('click',function(){go(1)});})();
</script>
{% schema %}{"name":"Volt essentials carousel","settings":[{"type":"text","id":"eyebrow","label":"Small text above","default":"Built for the dark."},{"type":"text","id":"title","label":"Title","default":"Shop the essentials"}],"blocks":[{"type":"card","name":"Card","settings":[{"type":"image_picker","id":"image","label":"Image","info":"Portrait 3:4. Keep the bottom third simple and dark; the text sits there."},{"type":"text","id":"label","label":"Small label"},{"type":"text","id":"title","label":"Title","default":"Collection"},{"type":"text","id":"button_label","label":"Button label","default":"Shop now"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":12,"presets":[{"name":"Volt essentials carousel"}]}{% endschema %}
