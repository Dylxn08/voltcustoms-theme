{% doc %}
  @prompt
    make me a daily countdown, make it so it adjusts to the customers time zone to show the end of the day for them
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-daily-countdown-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-daily-countdown__heading-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    text-align: center;
  }

  .ai-daily-countdown__timer-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.timer_gap }}px;
    align-items: center;
  }

  .ai-daily-countdown__unit-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: {{ block.settings.unit_width }}px;
  }

  .ai-daily-countdown__value-{{ ai_gen_id }} {
    font-size: {{ block.settings.number_size }}px;
    font-weight: 700;
    color: {{ block.settings.number_color }};
    line-height: 1;
    margin-bottom: {{ block.settings.label_spacing }}px;
  }

  .ai-daily-countdown__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-daily-countdown__separator-{{ ai_gen_id }} {
    font-size: {{ block.settings.number_size }}px;
    font-weight: 700;
    color: {{ block.settings.number_color }};
    line-height: 1;
    margin-bottom: {{ block.settings.label_spacing }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-daily-countdown__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-daily-countdown__value-{{ ai_gen_id }},
    .ai-daily-countdown__separator-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.number_size }}px * 0.8);
    }

    .ai-daily-countdown__label-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.label_size }}px * 0.8);
    }

    .ai-daily-countdown__unit-{{ ai_gen_id }} {
      min-width: calc({{ block.settings.unit_width }}px * 0.8);
    }
  }
{% endstyle %}

<daily-countdown-{{ ai_gen_id }} class="ai-daily-countdown-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-daily-countdown__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  <div class="ai-daily-countdown__timer-{{ ai_gen_id }}">
    <div class="ai-daily-countdown__unit-{{ ai_gen_id }}">
      <div class="ai-daily-countdown__value-{{ ai_gen_id }}" data-hours>00</div>
      <div class="ai-daily-countdown__label-{{ ai_gen_id }}">{{ block.settings.hours_label }}</div>
    </div>

    {% if block.settings.show_separator %}
      <div class="ai-daily-countdown__separator-{{ ai_gen_id }}">:</div>
    {% endif %}

    <div class="ai-daily-countdown__unit-{{ ai_gen_id }}">
      <div class="ai-daily-countdown__value-{{ ai_gen_id }}" data-minutes>00</div>
      <div class="ai-daily-countdown__label-{{ ai_gen_id }}">{{ block.settings.minutes_label }}</div>
    </div>

    {% if block.settings.show_separator %}
      <div class="ai-daily-countdown__separator-{{ ai_gen_id }}">:</div>
    {% endif %}

    <div class="ai-daily-countdown__unit-{{ ai_gen_id }}">
      <div class="ai-daily-countdown__value-{{ ai_gen_id }}" data-seconds>00</div>
      <div class="ai-daily-countdown__label-{{ ai_gen_id }}">{{ block.settings.seconds_label }}</div>
    </div>
  </div>
</daily-countdown-{{ ai_gen_id }}>

<script>
  (function() {
    class DailyCountdown{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.hoursEl = this.querySelector('[data-hours]');
        this.minutesEl = this.querySelector('[data-minutes]');
        this.secondsEl = this.querySelector('[data-seconds]');
      }

      connectedCallback() {
        this.updateCountdown();
        this.interval = setInterval(() => this.updateCountdown(), 1000);
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }

      updateCountdown() {
        const now = new Date();
        const endOfDay = new Date(now);
        endOfDay.setHours(23, 59, 59, 999);

        const diff = endOfDay - now;

        if (diff <= 0) {
          this.hoursEl.textContent = '00';
          this.minutesEl.textContent = '00';
          this.secondsEl.textContent = '00';
          return;
        }

        const hours = Math.floor(diff / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        this.hoursEl.textContent = String(hours).padStart(2, '0');
        this.minutesEl.textContent = String(minutes).padStart(2, '0');
        this.secondsEl.textContent = String(seconds).padStart(2, '0');
      }
    }

    customElements.define('daily-countdown-{{ ai_gen_id }}', DailyCountdown{{ ai_gen_id }});
  })();
</script>

