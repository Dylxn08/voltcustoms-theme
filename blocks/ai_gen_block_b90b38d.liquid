{% doc %}
  @prompt
    create a countdown for a storewide sale of 10 percent, I want it to say till september 31
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sale-countdown-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    text-align: {{ block.settings.alignment }};
  }

  .ai-sale-countdown-{{ ai_gen_id }}__content {
    max-width: 900px;
    margin: 0 auto;
  }

  .ai-sale-countdown-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 8px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ai-sale-countdown-{{ ai_gen_id }}__heading {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.1;
  }

  .ai-sale-countdown-{{ ai_gen_id }}__message {
    margin: 10px 0 0;
    color: {{ block.settings.text_color }};
    font-size: 16px;
  }

  .ai-sale-countdown-{{ ai_gen_id }}__timer {
    display: flex;
    justify-content: {{ block.settings.alignment }};
    gap: 10px;
    margin-top: 22px;
    flex-wrap: wrap;
  }

  .ai-sale-countdown-{{ ai_gen_id }}__unit {
    min-width: 76px;
    padding: 12px 10px;
    background: {{ block.settings.timer_background }};
    border: 1px solid {{ block.settings.accent_color }};
    border-radius: 8px;
  }

  .ai-sale-countdown-{{ ai_gen_id }}__number {
    display: block;
    color: {{ block.settings.timer_text_color }};
    font-size: 28px;
    font-weight: 700;
    line-height: 1;
  }

  .ai-sale-countdown-{{ ai_gen_id }}__label {
    display: block;
    margin-top: 7px;
    color: {{ block.settings.timer_text_color }};
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ai-sale-countdown-{{ ai_gen_id }}__expired {
    margin: 20px 0 0;
    color: {{ block.settings.text_color }};
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    .ai-sale-countdown-{{ ai_gen_id }} {
      width: 100%;
      padding: 24px 16px;
    }

    .ai-sale-countdown-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-sale-countdown-{{ ai_gen_id }}__unit {
      min-width: 64px;
      padding: 10px 8px;
    }

    .ai-sale-countdown-{{ ai_gen_id }}__number {
      font-size: 23px;
    }
  }
{% endstyle %}

<sale-countdown-{{ ai_gen_id }} class="ai-sale-countdown-{{ ai_gen_id }}" data-end-date="{{ block.settings.end_date | escape }}" {{ block.shopify_attributes }}>
  <div class="ai-sale-countdown-{{ ai_gen_id }}__content">
    {% if block.settings.eyebrow != blank %}
      <p class="ai-sale-countdown-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="ai-sale-countdown-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>
    {% if block.settings.message != blank %}
      <p class="ai-sale-countdown-{{ ai_gen_id }}__message">{{ block.settings.message }}</p>
    {% endif %}
    <div class="ai-sale-countdown-{{ ai_gen_id }}__timer" aria-live="polite">
      <div class="ai-sale-countdown-{{ ai_gen_id }}__unit"><span class="ai-sale-countdown-{{ ai_gen_id }}__number" data-days>00</span><span class="ai-sale-countdown-{{ ai_gen_id }}__label">Days</span></div>
      <div class="ai-sale-countdown-{{ ai_gen_id }}__unit"><span class="ai-sale-countdown-{{ ai_gen_id }}__number" data-hours>00</span><span class="ai-sale-countdown-{{ ai_gen_id }}__label">Hours</span></div>
      <div class="ai-sale-countdown-{{ ai_gen_id }}__unit"><span class="ai-sale-countdown-{{ ai_gen_id }}__number" data-minutes>00</span><span class="ai-sale-countdown-{{ ai_gen_id }}__label">Minutes</span></div>
      <div class="ai-sale-countdown-{{ ai_gen_id }}__unit"><span class="ai-sale-countdown-{{ ai_gen_id }}__number" data-seconds>00</span><span class="ai-sale-countdown-{{ ai_gen_id }}__label">Seconds</span></div>
    </div>
    <p class="ai-sale-countdown-{{ ai_gen_id }}__expired" hidden>{{ block.settings.expired_message }}</p>
  </div>
</sale-countdown-{{ ai_gen_id }}>

<script>
  (function() {
    class SaleCountdown{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.end = new Date(this.dataset.endDate.replace(' ', 'T')).getTime();
        this.days = this.querySelector('[data-days]');
        this.hours = this.querySelector('[data-hours]');
        this.minutes = this.querySelector('[data-minutes]');
        this.seconds = this.querySelector('[data-seconds]');
        this.expired = this.querySelector('.ai-sale-countdown-{{ ai_gen_id }}__expired');
        this.update();
        this.interval = window.setInterval(() => this.update(), 1000);
      }

      disconnectedCallback() {
        window.clearInterval(this.interval);
      }

      update() {
        const remaining = this.end - Date.now();
        if (remaining <= 0 || Number.isNaN(this.end)) {
          this.days.textContent = '00';
          this.hours.textContent = '00';
          this.minutes.textContent = '00';
          this.seconds.textContent = '00';
          this.expired.hidden = false;
          window.clearInterval(this.interval);
          return;
        }
        this.days.textContent = String(Math.floor(remaining / 86400000)).padStart(2, '0');
        this.hours.textContent = String(Math.floor(remaining / 3600000) % 24).padStart(2, '0');
        this.minutes.textContent = String(Math.floor(remaining / 60000) % 60).padStart(2, '0');
        this.seconds.textContent = String(Math.floor(remaining / 1000) % 60).padStart(2, '0');
      }
    }

    if (!customElements.get('sale-countdown-{{ ai_gen_id }}')) {
      customElements.define('sale-countdown-{{ ai_gen_id }}', SaleCountdown{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "Sale countdown",
  "settings": [
    {
      "type": "header",
      "content": "Sale content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Storewide sale"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Save 10% storewide"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "Sale ends September 31"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End date and time",
      "default": "2026-10-01 00:00"
    },
    {
      "type": "text",
      "id": "expired_message",
      "label": "Expired message",
      "default": "This sale has ended."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "poppins_n7"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile heading size",
      "min": 18,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#FFCC00"
    },
    {
      "type": "color",
      "id": "timer_background",
      "label": "Timer background",
      "default": "#242424"
    },
    {
      "type": "color",
      "id": "timer_text_color",
      "label": "Timer text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Sale countdown"
    }
  ],
  "tag": null,
  "class": "sale-countdown-block"
}
{% endschema %}