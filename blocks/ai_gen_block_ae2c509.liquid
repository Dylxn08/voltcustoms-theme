{% doc %}
  @prompt
    make something that says free shipping for the next 15 minutes
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-shipping-timer-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    text-align: center;
    width: 100%;
  }

  .ai-shipping-timer-content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .ai-shipping-timer-icon-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ai-shipping-timer-icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    fill: {{ block.settings.icon_color }};
  }

  .ai-shipping-timer-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    margin: 0;
  }

  .ai-shipping-timer-countdown-{{ ai_gen_id }} {
    font-size: {{ block.settings.timer_size }}px;
    font-weight: {{ block.settings.timer_weight }};
    color: {{ block.settings.timer_color }};
    font-variant-numeric: tabular-nums;
    min-width: 60px;
  }

  @media screen and (max-width: 749px) {
    .ai-shipping-timer-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.8 }}px {{ block.settings.padding_horizontal | times: 0.8 }}px;
    }

    .ai-shipping-timer-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-shipping-timer-countdown-{{ ai_gen_id }} {
      font-size: {{ block.settings.timer_size | times: 0.9 }}px;
    }

    .ai-shipping-timer-icon-{{ ai_gen_id }} svg {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<shipping-timer-{{ ai_gen_id }}
  class="ai-shipping-timer-{{ ai_gen_id }}"
  data-duration="{{ block.settings.timer_duration }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-shipping-timer-content-{{ ai_gen_id }}">
    {% if block.settings.show_icon %}
      <div class="ai-shipping-timer-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
        </svg>
      </div>
    {% endif %}
    <div class="ai-shipping-timer-text-{{ ai_gen_id }}">
      {{ block.settings.message_text }}
    </div>
    <div class="ai-shipping-timer-countdown-{{ ai_gen_id }}">
      <span class="ai-timer-display-{{ ai_gen_id }}">{{ block.settings.timer_duration }}:00</span>
    </div>
  </div>
</shipping-timer-{{ ai_gen_id }}>

<script>
  (function() {
    class ShippingTimer{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.duration = parseInt(this.dataset.duration) * 60;
        this.timerDisplay = this.querySelector('.ai-timer-display-{{ ai_gen_id }}');
        this.endTime = null;
      }

      connectedCallback() {
        this.initTimer();
      }

      initTimer() {
        const storageKey = 'shipping-timer-{{ ai_gen_id }}-end';
        const storedEndTime = localStorage.getItem(storageKey);
        const now = Math.floor(Date.now() / 1000);

        if (storedEndTime && parseInt(storedEndTime) > now) {
          this.endTime = parseInt(storedEndTime);
        } else {
          this.endTime = now + this.duration;
          localStorage.setItem(storageKey, this.endTime.toString());
        }

        this.updateDisplay();
        this.interval = setInterval(() => this.updateDisplay(), 1000);
      }

      updateDisplay() {
        const now = Math.floor(Date.now() / 1000);
        const remaining = Math.max(0, this.endTime - now);

        if (remaining === 0) {
          clearInterval(this.interval);
          const storageKey = 'shipping-timer-{{ ai_gen_id }}-end';
          localStorage.removeItem(storageKey);
          this.endTime = now + this.duration;
          localStorage.setItem(storageKey, this.endTime.toString());
          this.updateDisplay();
          this.interval = setInterval(() => this.updateDisplay(), 1000);
          return;
        }

        const minutes = Math.floor(remaining / 60);
        const seconds = remaining % 60;
        this.timerDisplay.textContent = minutes + ':' + (seconds < 10 ? '0' : '') + seconds;
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }
    }

    customElements.define('shipping-timer-{{ ai_gen_id }}', ShippingTimer{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Free shipping timer",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "message_text",
      "label": "Message",
      "default": "FREE SHIPPING for the next"
    },
    {
      "type": "range",
      "id": "timer_duration",
      "min": 1,
      "max": 60,
      "step": 1,
      "unit": "min",
      "label": "Timer duration",
      "default": 15
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show shipping icon",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 24
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#ffcc00"
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 14
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "header",
      "content": "Timer style"
    },
    {
      "type": "range",
      "id": "timer_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Timer size",
      "default": 16
    },
    {
      "type": "select",
      "id": "timer_weight",
      "label": "Timer weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "color",
      "id": "timer_color",
      "label": "Timer color",
      "default": "#ffcc00"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Free shipping timer"
    }
  ],
  "tag": null
}
{% endschema %}
