{% doc %}
  @prompt
    make me a daily countdown, make it so it adjusts to the customers time zone to show the end of the day for them
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-daily-countdown-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-daily-countdown__content-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-daily-countdown__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
  }

  .ai-daily-countdown__timer-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.text_alignment }};
    gap: {{ block.settings.timer_gap }}px;
    flex-wrap: wrap;
  }

  .ai-daily-countdown__unit-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: {{ block.settings.unit_width }}px;
  }

  .ai-daily-countdown__number-{{ ai_gen_id }} {
    font-size: {{ block.settings.number_size }}px;
    font-weight: 700;
    color: {{ block.settings.number_color }};
    background-color: {{ block.settings.number_bg_color }};
    padding: {{ block.settings.number_padding }}px;
    border-radius: {{ block.settings.number_border_radius }}px;
    min-width: {{ block.settings.number_min_width }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-daily-countdown__label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_size }}px;
    color: {{ block.settings.label_color }};
    margin-top: {{ block.settings.label_spacing }}px;
    text-transform: {{ block.settings.label_transform }};
  }

  @media screen and (max-width: 749px) {
    .ai-daily-countdown__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-daily-countdown__number-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.number_size }}px * 0.8);
      padding: calc({{ block.settings.number_padding }}px * 0.8);
      min-width: calc({{ block.settings.number_min_width }}px * 0.8);
    }

    .ai-daily-countdown__unit-{{ ai_gen_id }} {
      min-width: calc({{ block.settings.unit_width }}px * 0.8);
    }
  }
{% endstyle %}

<daily-countdown-{{ ai_gen_id }}
  class="ai-daily-countdown-{{ ai_gen_id }}"
  data-target-time="{{ block.settings.target_time }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-daily-countdown__content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-daily-countdown__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-daily-countdown__timer-{{ ai_gen_id }}">
      {% if block.settings.show_hours %}
        <div class="ai-daily-countdown__unit-{{ ai_gen_id }}">
          <div class="ai-daily-countdown__number-{{ ai_gen_id }}" data-unit="hours">00</div>
          <div class="ai-daily-countdown__label-{{ ai_gen_id }}">{{ block.settings.hours_label }}</div>
        </div>
      {% endif %}

      {% if block.settings.show_minutes %}
        <div class="ai-daily-countdown__unit-{{ ai_gen_id }}">
          <div class="ai-daily-countdown__number-{{ ai_gen_id }}" data-unit="minutes">00</div>
          <div class="ai-daily-countdown__label-{{ ai_gen_id }}">{{ block.settings.minutes_label }}</div>
        </div>
      {% endif %}

      {% if block.settings.show_seconds %}
        <div class="ai-daily-countdown__unit-{{ ai_gen_id }}">
          <div class="ai-daily-countdown__number-{{ ai_gen_id }}" data-unit="seconds">00</div>
          <div class="ai-daily-countdown__label-{{ ai_gen_id }}">{{ block.settings.seconds_label }}</div>
        </div>
      {% endif %}
    </div>
  </div>
</daily-countdown-{{ ai_gen_id }}>

<script>
  (function() {
    class DailyCountdown{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.targetTime = this.dataset.targetTime;
        this.hoursEl = this.querySelector('[data-unit="hours"]');
        this.minutesEl = this.querySelector('[data-unit="minutes"]');
        this.secondsEl = this.querySelector('[data-unit="seconds"]');
      }

      connectedCallback() {
        this.updateCountdown();
        this.interval = setInterval(() => this.updateCountdown(), 1000);
      }

      disconnectedCallback() {
        if (this.interval) {
          clearInterval(this.interval);
        }
      }

      updateCountdown() {
        const now = new Date();
        const target = new Date(now);
        
        const [hours, minutes] = this.targetTime.split(':');
        target.setHours(parseInt(hours), parseInt(minutes), 0, 0);
        
        if (target <= now) {
          target.setDate(target.getDate() + 1);
        }
        
        const diff = target - now;
        
        const hoursLeft = Math.floor(diff / (1000 * 60 * 60));
        const minutesLeft = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const secondsLeft = Math.floor((diff % (1000 * 60)) / 1000);
        
        if (this.hoursEl) {
          this.hoursEl.textContent = String(hoursLeft).padStart(2, '0');
        }
        if (this.minutesEl) {
          this.minutesEl.textContent = String(minutesLeft).padStart(2, '0');
        }
        if (this.secondsEl) {
          this.secondsEl.textContent = String(secondsLeft).padStart(2, '0');
        }
      }
    }

    customElements.define('daily-countdown-{{ ai_gen_id }}', DailyCountdown{{ ai_gen_id }});
  })();
</script>

