{% doc %}
  @prompt
    A section for one product, A bike theft prevention kit., let me just put the product there instead of an image, Dont show the description, just the Product name.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign product = block.settings.product %}

{% style %}
  .ai-bike-kit-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-bike-kit-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .ai-bike-kit-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-bike-kit-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    object-fit: cover;
  }

  .ai-bike-kit-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #1a1a1a;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-bike-kit-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-bike-kit-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    color: #666;
    font-size: 14px;
    text-align: center;
  }

  .ai-bike-kit-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 20px;
    left: 20px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-bike-kit-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .ai-bike-kit-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
    font-weight: 700;
  }

  .ai-bike-kit-features-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-bike-kit-feature-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .ai-bike-kit-feature-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    color: {{ block.settings.feature_icon_color }};
    margin-top: 2px;
  }

  .ai-bike-kit-feature-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.feature_text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
    margin: 0;
  }

  .ai-bike-kit-price-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .ai-bike-kit-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 700;
  }

  .ai-bike-kit-compare-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.compare_price_size }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
    opacity: 0.7;
  }

  .ai-bike-kit-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    width: fit-content;
  }

  .ai-bike-kit-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 989px) {
    .ai-bike-kit-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-bike-kit-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-bike-kit-price-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.price_size }}px * 0.85);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-bike-kit-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 16px;
    }

    .ai-bike-kit-container-{{ ai_gen_id }} {
      gap: 32px;
    }

    .ai-bike-kit-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }
  }
{% endstyle %}

<div class="ai-bike-kit-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-bike-kit-container-{{ ai_gen_id }}">
    <div class="ai-bike-kit-image-wrapper-{{ ai_gen_id }}">
      {% if product and product.featured_image %}
        <img
          src="{{ product.featured_image | image_url: width: 1000 }}"
          alt="{{ product.featured_image.alt | escape }}"
          loading="lazy"
          width="{{ product.featured_image.width }}"
          height="{{ product.featured_image.height }}"
          class="ai-bike-kit-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-bike-kit-image-placeholder-{{ ai_gen_id }}">
          {{ 'product-1' | placeholder_svg_tag }}
          <div class="ai-bike-kit-empty-state-{{ ai_gen_id }}">
            Select a product
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_badge %}
        {% if product and product.compare_at_price > product.price %}
          {% assign savings_percent = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
          <div class="ai-bike-kit-badge-{{ ai_gen_id }}">
            Save {{ savings_percent }}%
          </div>
        {% elsif block.settings.badge_text != blank %}
          <div class="ai-bike-kit-badge-{{ ai_gen_id }}">
            {{ block.settings.badge_text }}
          </div>
        {% endif %}
      {% endif %}
    </div>

    <div class="ai-bike-kit-content-{{ ai_gen_id }}">
      {% if product %}
        <h2 class="ai-bike-kit-heading-{{ ai_gen_id }}">
          {{ product.title }}
        </h2>
      {% elsif block.settings.heading != blank %}
        <h2 class="ai-bike-kit-heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.show_features %}
        <div class="ai-bike-kit-features-{{ ai_gen_id }}">
          {% if block.settings.feature_1 != blank %}
            <div class="ai-bike-kit-feature-{{ ai_gen_id }}">
              <svg class="ai-bike-kit-feature-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <p class="ai-bike-kit-feature-text-{{ ai_gen_id }}">{{ block.settings.feature_1 }}</p>
            </div>
          {% endif %}

          {% if block.settings.feature_2 != blank %}
            <div class="ai-bike-kit-feature-{{ ai_gen_id }}">
              <svg class="ai-bike-kit-feature-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <p class="ai-bike-kit-feature-text-{{ ai_gen_id }}">{{ block.settings.feature_2 }}</p>
            </div>
          {% endif %}

          {% if block.settings.feature_3 != blank %}
            <div class="ai-bike-kit-feature-{{ ai_gen_id }}">
              <svg class="ai-bike-kit-feature-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <p class="ai-bike-kit-feature-text-{{ ai_gen_id }}">{{ block.settings.feature_3 }}</p>
            </div>
          {% endif %}

          {% if block.settings.feature_4 != blank %}
            <div class="ai-bike-kit-feature-{{ ai_gen_id }}">
              <svg class="ai-bike-kit-feature-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <p class="ai-bike-kit-feature-text-{{ ai_gen_id }}">{{ block.settings.feature_4 }}</p>
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if product %}
        <div class="ai-bike-kit-price-wrapper-{{ ai_gen_id }}">
          <span class="ai-bike-kit-price-{{ ai_gen_id }}">{{ product.price | money }}</span>
          {% if product.compare_at_price > product.price %}
            <span class="ai-bike-kit-compare-price-{{ ai_gen_id }}">{{ product.compare_at_price | money }}</span>
          {% endif %}
        </div>
      {% endif %}

      {% if product %}
        <a
          href="{{ product.url }}"
          class="ai-bike-kit-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% elsif block.settings.button_text != blank %}
        <a
          href="{{ block.settings.button_link }}"
          class="ai-bike-kit-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bike theft prevention kit",
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 12
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Custom badge text",
      "info": "Shows if product has no sale price"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "#ffcc00"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Fallback content"
    },
    {
      "type": "paragraph",
      "content": "These settings are used when no product is selected"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ultimate Bike Theft Prevention Kit"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 42
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#cccccc"
    },
    {
      "type": "header",
      "content": "Features"
    },
    {
      "type": "checkbox",
      "id": "show_features",
      "label": "Show features",
      "default": true
    },
    {
      "type": "text",
      "id": "feature_1",
      "label": "Feature 1",
      "default": "Heavy-duty U-lock with anti-pick cylinder"
    },
    {
      "type": "text",
      "id": "feature_2",
      "label": "Feature 2",
      "default": "GPS tracking device with mobile app"
    },
    {
      "type": "text",
      "id": "feature_3",
      "label": "Feature 3",
      "default": "Motion-activated alarm (110dB)"
    },
    {
      "type": "text",
      "id": "feature_4",
      "label": "Feature 4",
      "default": "Weatherproof cable lock for accessories"
    },
    {
      "type": "range",
      "id": "feature_text_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Feature text size",
      "default": 15
    },
    {
      "type": "color",
      "id": "feature_icon_color",
      "label": "Feature icon color",
      "default": "#ffcc00"
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "range",
      "id": "price_size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Price size",
      "default": 32
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#ffcc00"
    },
    {
      "type": "range",
      "id": "compare_price_size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Compare price size",
      "default": 20
    },
    {
      "type": "color",
      "id": "compare_price_color",
      "label": "Compare price color",
      "default": "#999999"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Fallback button link",
      "info": "Used when no product is selected"
    },
    {
      "type": "range",
      "id": "button_text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Button text size",
      "default": 16
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#ffcc00"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover background",
      "default": "#e6b800"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "button_border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Button border width",
      "default": 2
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Button border color",
      "default": "#ffcc00"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 6
    },
    {
      "type": "header",
      "content": "Section settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Section padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Bike theft prevention kit"
    }
  ]
}
{% endschema %}
